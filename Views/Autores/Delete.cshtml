@model Autor
@{
    ViewData["Title"] = "Excluir Autor";
}

<h1>Excluir Autor</h1>

<p>Tem certeza que deseja excluir o autor abaixo?</p>

<dl>
    <dt>Nome</dt>
    <dd>@Model.Nome</dd>

    <dt>Nacionalidade</dt>
    <dd>@Model.Nacionalidade</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit">Confirmar Exclusão</button>
    <a asp-action="Index">Cancelar</a>
</form>
