@model Emprestimo
@{
    ViewData["Title"] = "Excluir Empréstimo";
}

<h1>Excluir Empréstimo</h1>

<p>Tem certeza que deseja excluir o empréstimo abaixo?</p>

<dl>
    <dt>Livro</dt>
    <dd>@(Model.Livro?.Titulo)</dd>

    <dt>Leitor</dt>
    <dd>@Model.NomeLeitor</dd>

    <dt>Data do Empréstimo</dt>
    <dd>@Model.DataEmprestimo.ToString("dd/MM/yyyy")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit">Confirmar Exclusão</button>
    <a asp-action="Index">Cancelar</a>
</form>
