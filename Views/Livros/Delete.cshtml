@model Livro
@{
    ViewData["Title"] = "Excluir Livro";
}

<h1>Excluir Livro</h1>

<p>Tem certeza que deseja excluir o livro abaixo?</p>

<dl>
    <dt>Título</dt>
    <dd>@Model.Titulo</dd>

    <dt>ISBN</dt>
    <dd>@Model.Isbn</dd>

    <dt>Autor</dt>
    <dd>@(Model.Autor?.Nome)</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit">Confirmar Exclusão</button>
    <a asp-action="Index">Cancelar</a>
</form>
