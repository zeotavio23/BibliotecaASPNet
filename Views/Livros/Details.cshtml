@model Livro
@{
    ViewData["Title"] = "Detalhes do Livro";
}

<h1>Detalhes do Livro</h1>

<dl>
    <dt>Título</dt>
    <dd>@Model.Titulo</dd>

    <dt>ISBN</dt>
    <dd>@Model.Isbn</dd>

    <dt>Ano de Publicação</dt>
    <dd>@Model.AnoPublicacao</dd>

    <dt>Gênero</dt>
    <dd>@Model.Genero</dd>

    <dt>Número de Páginas</dt>
    <dd>@Model.NumeroPaginas</dd>

    <dt>Autor</dt>
    <dd>@(Model.Autor?.Nome)</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
<a asp-action="Index">Voltar à lista</a>
